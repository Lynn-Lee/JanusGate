# JanusGate local development example.
# Copy to .env and replace every secret before use. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_DB=janusgate
POSTGRES_USER=janusgate
POSTGRES_PASSWORD=replace-with-local-postgres-password
DATABASE_URL=postgresql+asyncpg://janusgate:replace-with-local-postgres-password@postgres:5432/janusgate

REDIS_URL=redis://redis:6379/0

# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace-with-64-hex-character-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_GLOBAL_PER_MINUTE=120
